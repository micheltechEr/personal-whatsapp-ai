# Configurações do Servidor & Dashboard
PORT=3000

# Conexão WhatsApp Baileys (coloque true para conectar e exibir QR Code)
START_WHATSAPP=false

# Provedor LLM Agnóstico (Compatível com OpenAI, OmniRoute, Groq, Ollama, Gemini)
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=antigravity/gemini-3.8-flash-tiered
LLM_API_KEY=

# Banco de dados (opcional - usa armazenamento local se vazio)
# DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_ai
